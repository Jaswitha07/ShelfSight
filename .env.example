# ShelfSight Environment Configuration

# Server Port
PORT=5000

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# JWT Secret for Authentication
JWT_SECRET=shelfsight_super_secret_jwt_key_change_in_production_2026

# Vision Service URL (FastAPI)
VISION_URL=http://localhost:8000

# Database Connection (PostgreSQL or Supabase)
# Leave empty or set to postgresql://user:password@localhost:5432/shelfsight
# If no Postgres server is running, ShelfSight automatically falls back to embedded PGlite for local zero-config testing!
DATABASE_URL=

# Optional Supabase credentials if using Supabase directly
SUPABASE_URL=
SUPABASE_ANON_KEY=
